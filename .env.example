# -----------------------------
# BACKEND ENVIRONMENT VARIABLES
# -----------------------------

# Server port
PORT=5000

# Node environment (development or production)
NODE_ENV=development

# MongoDB connection string (Replace with your own cluster URL or local URL)
# Example: mongodb+srv://username:password@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/portfolio

# JWT Secret for admin authentication (Generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Allowed frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# -----------------------------
# FRONTEND ENVIRONMENT VARIABLES
# -----------------------------
# Note: In Vite, frontend env variables must start with VITE_

# Base URL for the backend API
VITE_API_URL=http://localhost:5000/api
